.donut {
  position: relative;
  width: 100%;
  height: 100%;
}

.donut-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.donut-center {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.dc-label {
  font-size: 21rpx;
  color: #8a90a6;
}

.dc-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2437;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}
