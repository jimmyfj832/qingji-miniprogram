/* ---------- 个人卡 ---------- */
.profile {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #6366f1, #a855f7);
  color: #fff;
  font-size: 38rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(99, 102, 241, 0.3);
}

.pf-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.pf-name {
  font-size: 32rpx;
  font-weight: 600;
}

.pf-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.pf-edit {
  font-size: 24rpx;
  color: var(--primary);
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(99, 102, 241, 0.08);
}

/* ---------- 键值行 ---------- */
.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}

.kv-row:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.kv-k {
  color: var(--muted);
}

.kv-v {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ---------- 设置项 ---------- */
.list {
  padding: 6rpx 28rpx;
}

.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.set-row:last-child {
  border-bottom: none;
}

.set-row:active {
  opacity: 0.7;
}

.sr-label {
  font-size: 28rpx;
}

.sr-label.danger {
  color: var(--expense);
}

.sr-right {
  display: flex;
  align-items: center;
}

.sr-val {
  font-size: 26rpx;
  color: var(--text);
  margin-right: 10rpx;
}

.sr-val.placeholder {
  color: var(--muted);
  font-size: 24rpx;
}

.sr-arrow {
  font-size: 30rpx;
  color: #c8ccdb;
  line-height: 1;
}

/* ---------- 关于 ---------- */
.about {
  display: flex;
  flex-direction: column;
}

.about-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.about-p {
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.75;
  margin-bottom: 10rpx;
}

.about-warn {
  color: #d97706;
}

/* ---------- 编辑弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(18, 20, 35, 0.45);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 34rpx 34rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.sheet-title {
  font-size: 31rpx;
  font-weight: 600;
  margin-bottom: 26rpx;
}

.sheet-input {
  height: 96rpx;
  background: #f4f5fb;
  border-radius: 20rpx;
  padding: 0 26rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.sheet-hint {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 14rpx;
}

.sheet-actions {
  display: flex;
  margin-top: 34rpx;
}

.sa-cancel,
.sa-ok {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.sa-cancel {
  background: #f4f5fb;
  color: var(--muted);
  margin-right: 20rpx;
}

.sa-ok {
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  color: #fff;
}
