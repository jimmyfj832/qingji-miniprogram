.edit-page {
  min-height: 100vh;
  padding: 20rpx 24rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ---------- 类型切换 ---------- */
.type-switch {
  display: flex;
  background: #fff;
  border-radius: 22rpx;
  padding: 6rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 66, 120, 0.06);
}

.ts {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--muted);
  transition: all 0.2s;
}

.ts.on.out {
  background: linear-gradient(135deg, #f87171, #ef4444);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(239, 68, 68, 0.28);
}

.ts.on.in {
  background: linear-gradient(135deg, #34d399, #10b981);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.28);
}

/* ---------- 金额 ---------- */
.amount-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 30rpx;
  padding: 20rpx 30rpx;
  margin: 22rpx 0;
  box-shadow: 0 12rpx 34rpx rgba(60, 66, 120, 0.06);
}

.ac-cur {
  font-size: 42rpx;
  font-weight: 600;
  color: #b6bacb;
  margin-right: 14rpx;
}

.ac-input {
  flex: 1;
  height: 100rpx;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -1rpx;
}

.ac-input.in {
  color: var(--income);
}

.ac-ph {
  color: #d5d8e4;
  font-weight: 400;
}

/* ---------- 分类网格 ---------- */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
}

.cat {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 18rpx;
}

.cat-ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  transition: background 0.18s;
}

.cat:active .cat-ico {
  transform: scale(0.94);
}

.cat-name {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 10rpx;
}

.cat.on .cat-name {
  color: var(--text);
  font-weight: 600;
}

/* ---------- 表单行 ---------- */
.form {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-row:last-child {
  border-bottom: none;
}

.fl {
  font-size: 28rpx;
  width: 110rpx;
  flex-shrink: 0;
}

.fv {
  text-align: right;
  font-size: 27rpx;
}

.fv-arrow {
  color: #c8ccdb;
  margin-left: 6rpx;
}

.fv-input {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  height: 48rpx;
}

.fv-ph {
  color: #b6bacb;
}

/* ---------- 图片网格（4 列，用负边距抵消末列间距） ---------- */
.thumb-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -14rpx;
}

.thumb,
.thumb-add {
  width: 151rpx;
  height: 151rpx;
  border-radius: 20rpx;
  margin: 0 14rpx 14rpx 0;
  position: relative;
}

.thumb-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  display: block;
  background: #f1f2f9;
}

.thumb-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(31, 36, 55, 0.62);
  color: #fff;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.thumb-add {
  border: 2rpx dashed #d9dceb;
  background: #fafbff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.thumb-add:active {
  border-color: var(--primary);
}

.ta-plus {
  font-size: 38rpx;
  color: #b6bacb;
  line-height: 1;
}

.ta-txt {
  font-size: 19rpx;
  color: var(--muted);
  margin-top: 10rpx;
}

/* ---------- 底部操作栏 ---------- */
.foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -8rpx 30rpx rgba(60, 66, 120, 0.07);
  z-index: 50;
}

.foot-del {
  width: 176rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #fff5f5;
  border: 1rpx solid #fee2e2;
  color: var(--expense);
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.foot-save {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(99, 102, 241, 0.3);
}

.foot-save.disabled {
  opacity: 0.6;
}
