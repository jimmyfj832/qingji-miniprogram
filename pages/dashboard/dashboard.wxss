/* ---------- 月份切换 ---------- */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 22rpx;
}

.mb-arrow {
  width: 72rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--muted);
  line-height: 1;
  border-radius: 16rpx;
}

.mb-arrow:active {
  background: rgba(99, 102, 241, 0.08);
  color: var(--primary);
}

.mb-arrow.disabled {
  opacity: 0.25;
}

.mb-text {
  font-size: 32rpx;
  font-weight: 600;
  min-width: 200rpx;
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* ---------- 结余主卡 ---------- */
.hero {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 36rpx 34rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #6366f1 0%, #7c6cf5 48%, #a855f7 100%);
  box-shadow: 0 16rpx 44rpx rgba(99, 102, 241, 0.32);
}

.hero-glow {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
  top: -140rpx;
  right: -90rpx;
}

.hero-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 1rpx;
}

.hero-value {
  display: block;
  font-size: 68rpx;
  font-weight: 700;
  color: #fff;
  margin: 10rpx 0 26rpx;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.hero-value.neg {
  color: #ffe4e6;
}

.hero-foot {
  display: flex;
  align-items: stretch;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}

.hf-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hf-item:last-child {
  padding-left: 30rpx;
}

.hf-line {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 4rpx 0;
}

.hf-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hf-val {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.hf-cmp {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.62);
  margin-top: 4rpx;
}

.hf-cmp.cmp-up,
.hf-cmp.cmp-down,
.hf-cmp.cmp-flat {
  color: rgba(255, 255, 255, 0.72);
}

/* ---------- 预算进度 ---------- */
.bar-bg {
  height: 16rpx;
  border-radius: 10rpx;
  background: #eef0f8;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #6366f1, #a855f7);
  transition: width 0.35s ease;
}

.bar-fill.over {
  background: linear-gradient(90deg, #f87171, #ef4444);
}

.budget-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 23rpx;
}

/* ---------- 环形图 + 图例 ---------- */
.donut-box {
  width: 320rpx;
  height: 320rpx;
  margin: 10rpx auto 24rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
}

.lg {
  width: 50%;
  display: flex;
  align-items: center;
  padding: 9rpx 0;
}

.lg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.lg-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lg-pct {
  font-size: 23rpx;
  color: var(--muted);
  margin-left: 8rpx;
}
