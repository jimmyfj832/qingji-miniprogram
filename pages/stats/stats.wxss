/* ---------- 概览卡 ---------- */
.stat-cards {
  display: flex;
  margin-bottom: 24rpx;
}

.sc {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 26rpx;
  padding: 22rpx 16rpx;
  margin-right: 14rpx;
  box-shadow: 0 10rpx 30rpx rgba(60, 66, 120, 0.06);
}

.sc:last-child {
  margin-right: 0;
}

.sc-label {
  font-size: 21rpx;
  color: var(--muted);
}

.sc-value {
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
}

.sc-value.in {
  color: var(--income);
}

/* ---------- 柱状图 ---------- */
.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 10rpx 4rpx 0;
}

.bar-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bars {
  height: 200rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 20rpx;
  margin: 0 3rpx;
  border-radius: 8rpx 8rpx 3rpx 3rpx;
  min-height: 2rpx;
}

.bar-in {
  background: linear-gradient(180deg, #34d399, #10b981);
}

.bar-out {
  background: linear-gradient(180deg, #818cf8, #6366f1);
}

.bar-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 12rpx;
  height: 28rpx;
  line-height: 28rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.cl {
  display: flex;
  align-items: center;
  margin: 0 18rpx;
}

.cl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.dot-in {
  background: #10b981;
}

.dot-out {
  background: #6366f1;
}

/* ---------- 分类排行 ---------- */
.seg-type {
  margin: 4rpx 0 26rpx;
  background: #f4f5fb;
  box-shadow: none;
  padding: 5rpx;
}

.rank {
  margin-bottom: 26rpx;
}

.rank:last-child {
  margin-bottom: 4rpx;
}

.rk-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.rk-name {
  font-weight: 500;
}

.rk-amt {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.rk-bar {
  height: 12rpx;
  background: #f1f2f9;
  border-radius: 8rpx;
  overflow: hidden;
}

.rk-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.rk-foot {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
